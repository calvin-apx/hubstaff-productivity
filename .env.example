# Copy this file to .env and fill in the token. Everything else has a sensible default.

# Hubstaff Personal Access Token created JUST for this app.
# https://developer.hubstaff.com/personal_access_tokens
# Do not reuse the token from the Claude MCP server: Hubstaff rotates the token on
# every refresh, so two programs sharing one token lock each other out.
HUBSTAFF_PAT=

# Optional. Auto-detected from the token when empty (first organization you belong to).
HUBSTAFF_ORGANIZATION_ID=
HUBSTAFF_USER_ID=

# Optional: pull "what to do next" from Jira Cloud. All three are needed to enable it.
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
# Example base URL: https://your-site.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# JQL for the suggestion list. Default: your open issues, most recently updated first.
# JIRA_JQL=assignee = currentUser() AND statusCategory != Done ORDER BY updated DESC
# Statuses to show first, matched as substrings of the status name. Unlisted ones go last.
# JIRA_STATUS_ORDER=In Progress,To Do,Code Review,In Test,Blocked

# Server port. The Vite dev server proxies /api to this port (see client/vite.config.js).
PORT=3939

# Productivity rule inputs. The rule itself lives in server/src/productivity.js.
TARGET_HOURS=8
MIN_ACTIVITY_PERCENT=50

# Desktop notification: one toast per day with the verdict, sent on the first
# check after NOTIFY_AFTER (local time). Checks run every CHECK_INTERVAL_MINUTES.
NOTIFY_AFTER=17:00
CHECK_INTERVAL_MINUTES=30
NOTIFY_WHEN_PRODUCTIVE=true
